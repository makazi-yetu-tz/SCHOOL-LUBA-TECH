# Nakili faili hili kuwa .env na ujaze, kisha endesha:
#   set -a; . ./.env; set +a; node server.js

PORT=3000
NODE_ENV=production

# Neno la siri refu la nasibu (mfano: openssl rand -hex 32). USIWEKE kwenye HTML.
SESSION_SECRET=

# Malipo. "mock" ni kwa majaribio tu na HAIRUHUSIWI kwenye production.
# Ukishachagua mtoa huduma (Selcom/AzamPay/ClickPesa...), ongeza adapter kwenye gateways() ndani ya server.js.
GATEWAY=dalipay
DALIPAY_PUBLIC_KEY=
DALIPAY_SECRET_KEY=
# DALIPAY_BASE=https://app.dalipay.co.tz/api/v1
# Kama nyaraka za DaliPay zinatofautiana na chaguo-msingi, badilisha hapa:
# DALIPAY_COLLECT_PATH=/collections
# DALIPAY_STATUS_PATH=/collections/
# DALIPAY_HEADER_PUBLIC=X-Public-Key
# DALIPAY_HEADER_SECRET=X-Secret-Key
# Webhook ya DaliPay (weka kwenye Settings zao): https://DOMAIN-YAKO/api/webhook/dalipay
# Neno la siri la kusaini webhook kutoka kwa gateway
WEBHOOK_SECRET=

# SMS: nextsms (inapendekezwa kwako), beem, au console (majaribio, inaandika kwenye log)
SMS_PROVIDER=nextsms
NEXTSMS_USERNAME=
NEXTSMS_PASSWORD=
NEXTSMS_SENDER=
# (au badala ya username/password: NEXTSMS_API_KEY=base64 ya "username:password")
BEEM_API_KEY=
BEEM_SECRET=
BEEM_SENDER=INFO

# Ufunguo wa mmiliki (admin): ukomo wa SMS na kuweka alama ya payout. Usiache tupu kwenye production.
ADMIN_KEY=
# SMS ambazo kila shule inaruhusiwa kwa mwezi (wewe ndiye unanunua SMS)
SMS_QUOTA_DEFAULT=1000
# SMS_QUOTA_DEFAULT ni kikomo cha usalama cha wapokeaji kwa shule kwa mwezi (unaweza kuongeza kwa shule moja kwenye Admin).
# Ujumbe kwa wazazi wote: mara 2 kwa wiki na 8 kwa mwezi kwa kila shule. Kumtumia mzazi mmoja hakuhesabiwi.
# BROADCASTS_PER_WEEK=2
# BROADCASTS_PER_MONTH=8
# SMS_PER_PHONE_DAY=3   # SMS za shule kwa namba moja kwa saa 24, kutoka shule zote (kuzuia spam)

# Kiungo cha video ya ukurasa wa mbele (https://... au /njia). Haiwekwi kwenye msimbo.
VIDEO_URL=

# Majaribio TU kwenye kompyuta yako: ruhusu GATEWAY=mock na SMS_PROVIDER=console (bila hiki seva haiwaki). Usiweke production.
# ALLOW_MOCK=1

# Usajili wa akaunti kwa saa kwa kila IP (chaguo-msingi 10)
# REG_PER_HOUR=10

# Kiungo halisi cha mfumo (kinaingia kwenye SMS za mwaliko), mfano https://skuli.example.com
APP_URL=

# Weka 1 ikiwa seva iko nyuma ya nginx/Cloudflare (ili IP halisi itumike kwenye rate limit)
TRUST_PROXY=0

# Akaunti (shule/mzazi) zisizoingia kwa siku hizi zinafutwa zenyewe (chaguo-msingi 60 = miezi 2). Shule yenye salio la kamisheni haifutwi.
# INACTIVE_DAYS=60
